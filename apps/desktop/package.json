{
  "name": "@owlery/desktop",
  "version": "0.0.3",
  "private": true,
  "description": "The Owlery desktop app",
  "license": "Apache-2.0",
  "main": "dist/main.js",
  "scripts": {
    "postinstall": "electron-rebuild --only node-pty",
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-in-electron.mjs",
    "check": "pnpm run typecheck && pnpm run test",
    "korean:typed": "OWLERY_KOREAN_TYPED=1 node scripts/test-in-electron.mjs test/korean-input.test.ts",
    "measure:memory": "OWLERY_MEASURE_MEMORY=1 node scripts/test-in-electron.mjs test/memory.test.ts",
    "role:run": "OWLERY_ROLE_RUN=1 node scripts/test-in-electron.mjs test/role-session.test.ts",
    "role:refusal": "OWLERY_ROLE_REFUSAL=1 node scripts/test-in-electron.mjs test/role-session.test.ts",
    "role:refusal:sealer": "OWLERY_ROLE_REFUSAL=sealer node scripts/test-in-electron.mjs test/role-session.test.ts",
    "settle": "node scripts/settle.mjs",
    "screenshots": "OWLERY_SCREENSHOTS=1 node scripts/test-in-electron.mjs test/screenshots.test.ts"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "electron": "45.3.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
