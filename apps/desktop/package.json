{
  "name": "@owlery/desktop",
  "version": "0.0.1",
  "private": true,
  "description": "The Owlery desktop app",
  "license": "Apache-2.0",
  "main": "dist/main.js",
  "scripts": {
    "postinstall": "electron-rebuild --only node-pty",
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-in-electron.mjs",
    "check": "pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@types/node": "22.20.5",
    "electron": "45.3.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
